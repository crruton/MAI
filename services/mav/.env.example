# Конфигурация MAV. Скопируйте в .env и заполните.
# .env в git не попадает (см. .gitignore).

# --- Шлюз MAI (обязательно) ---
MAI_BASE_URL=https://api-ai.mai.ru/v1
MAI_API_KEY=
MAI_TTS_MODEL=silero-tts

# --- Сервер ---
# 127.0.0.1 — только локальный доступ. 0.0.0.0 — доступ из сети (нужен MAV_API_KEY).
MAV_HOST=127.0.0.1
MAV_PORT=3901

# Ключ для /api/*. Пусто — проверка выключена (допустимо только для localhost).
MAV_API_KEY=

# Куда писать аудио и историю.
MAV_DATA_DIR=./data

# --- Локальный движок Piper (необязательно, не проверено) ---
# Нужен бинарник piper и ONNX-модели голосов.
PIPER_BIN=
PIPER_VOICES_DIR=./voices

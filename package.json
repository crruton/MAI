{
  "name": "mai-code",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop coding agent for MAI models — chat client with tools, AGENTS.md, skills, MCP and plugins",
  "type": "module",
  "main": "electron/main.js",
  "author": "crruton",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/crruton/mai-code.git"
  },
  "homepage": "https://github.com/crruton/mai-code#readme",
  "keywords": [
    "electron",
    "ai-agent",
    "coding-agent",
    "vibe-coding",
    "mai",
    "llm",
    "mcp"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "icon": "node scripts/make-icon.mjs",
    "shortcut": "powershell -ExecutionPolicy Bypass -File ./install-shortcut.ps1",
    "skills:install": "node scripts/install-skills.mjs",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "pack:tar": "node scripts/make-tar.mjs",
    "pack:offline": "node scripts/make-offline.mjs",
    "pack:sums": "node scripts/make-sums.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "test": "node scripts/test-policy.mjs && node scripts/test-secrets.mjs && node scripts/test-interactive.mjs && node scripts/test-trust.mjs && node scripts/test-ipc-permissions.mjs && node scripts/test-runtimes.mjs && node scripts/test-vision.mjs && node scripts/test-usage.mjs && node scripts/test-project-lock.mjs && node scripts/test-permissions.mjs && node scripts/test-permissions-integration.mjs && node scripts/test-attachments.mjs && node scripts/test-ocr.mjs && node scripts/test-shell.mjs",
    "test:permissions": "node scripts/test-policy.mjs && node scripts/test-permissions.mjs && node scripts/test-permissions-integration.mjs",
    "test:agent": "electron scripts/test-agent-loop.mjs",
    "test:plugins": "electron scripts/test-plugin-host.mjs",
    "test:shell": "node scripts/test-shell.mjs",
    "test:electron": "electron scripts/smoke-electron.mjs",
    "test:ui": "electron scripts/test-ui.mjs",
    "test:attachments": "node scripts/test-attachments.mjs",
    "test:ocr": "node scripts/test-ocr.mjs",
    "test:memory": "electron scripts/test-memory-tools.mjs",
    "test:responses": "node scripts/test-responses.mjs",
    "test:export": "node scripts/test-export.mjs",
    "multica:sync": "node scripts/multica-sync.mjs",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f --tail=100",
    "docker:gc": "node scripts/docker-gc.mjs --build-cache",
    "docker:gc:dry": "node scripts/docker-gc.mjs --dry-run",
    "docker:mem": "node scripts/docker-mem.mjs",
    "docker:mem:check": "node scripts/docker-mem.mjs --check",
    "obs:up": "docker compose -f infra/observability/docker-compose.yml up -d",
    "obs:down": "docker compose -f infra/observability/docker-compose.yml down",
    "obs:smoke": "node scripts/otel-smoke.mjs",
    "harbor:check": "node scripts/harbor-check.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "mermaid": "^12.2.0",
    "openai": "^6.0.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "allowScripts": {
    "electron@38.8.6": true
  }
}
